# Copy to .env.local for local runs. Leave these unset on a public deployment:
# there every visitor brings their own keys through the API keys dialog.
BASETEN_API_KEY=
CHALLENGER_API_KEY=
# Optional: a self-hosted elephant-1. Default: `npm run mlx` on http://127.0.0.1:8765.
# For llama-server on another machine: http://<its-ip>:8999
LOCAL_ELEPHANT_URL=
